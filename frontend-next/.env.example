# Copy to frontend-next/.env.local if you need to change these. The defaults work for local dev.

# Where the Next.js server proxies /api/*. Server-side only, never sent to the browser.
API_ORIGIN=http://localhost:4000

# Socket.IO connects straight to the API (Vercel can't proxy WebSockets). Used from Phase 2.
# NEXT_PUBLIC_ values ARE shipped to the browser, so never put a secret in one.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
