# Copy to backend/.env and fill in. backend/.env is gitignored, never commit it.

NODE_ENV=development
PORT=4000

# Local MongoDB without Docker: run `npm run db` in another terminal and keep this value.
# Atlas: use YOUR OWN cluster, e.g. mongodb+srv://<user>:<password>@<cluster-host>/zcoder
MONGODB_URI=mongodb://127.0.0.1:27017/zcoder

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_COST=12

# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Reverse proxies in front of the API: 0 locally, 1 on Render.
TRUST_PROXY=0
LOG_LEVEL=info

# Per 15 minutes.
AUTH_RATE_LIMIT_PER_IP=50
LOGIN_FAILURES_PER_EMAIL=5

# Failed room joins (wrong password / unknown code) per user per 15 minutes.
ROOM_JOIN_FAILURES_PER_USER=10
# Chat messages per user per 10 seconds (all tabs together).
CHAT_MESSAGES_PER_10S=20

# Save a room's shared document this long after the last edit (milliseconds).
YJS_PERSIST_DEBOUNCE_MS=2000

# ---- Code execution ----
# local  = runs code as child processes on THIS machine with NO sandbox (development only).
#          The server refuses to start with EXECUTOR=local when NODE_ENV=production.
# judge0 = Judge0 called from the server. Use YOUR OWN RapidAPI key, or a self-hosted Judge0 URL.
EXECUTOR=local
EXECUTION_CONCURRENCY=2
EXECUTION_QUEUE_MAX=50
EXECUTIONS_PER_MINUTE=10
RUN_TIMEOUT_MS=3000
COMPILE_TIMEOUT_MS=20000
RUN_MEMORY_MB=256
# Judge0 (only read when EXECUTOR=judge0). A RapidAPI host requires JUDGE0_RAPIDAPI_KEY.
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=
# For a self-hosted Judge0 with AUTHN enabled:
JUDGE0_AUTH_TOKEN=
# Local executor toolchain (EXECUTOR=local). Defaults: g++, and python (Windows) / python3.
# LOCAL_CXX=g++
# LOCAL_PYTHON=python
